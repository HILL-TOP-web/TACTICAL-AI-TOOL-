# ==================================================
# 1. APPLICATION CONFIGURATION
# ==================================================
NODE_ENV=development
PORT=3000
APP_NAME=SkyDrop
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# ==================================================
# 2. SECURITY
# ==================================================
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=86400

# ==================================================
# 3. DATABASE
# ==================================================
DATABASE_URL=
DATABASE_SSL=false

# ==================================================
# 4. MONNIFY CONFIGURATION
# ==================================================
MONNIFY_BASE_URL=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

MONNIFY_ENABLED=false
MONNIFY_TIMEOUT_MS=15000
MONNIFY_CONNECTIVITY_CHECK_ENABLED=true

# ==================================================
# 5. WITHDRAWALS
# ==================================================
SKYDROP_WITHDRAWALS_ENABLED=false
SKYDROP_MIN_WITHDRAWAL_NGN=100
SKYDROP_MAX_WITHDRAWAL_NGN=100000
SKYDROP_DAILY_WITHDRAWAL_LIMIT_NGN=200000
SKYDROP_MAX_DAILY_WITHDRAWALS=5
SKYDROP_MAX_PENDING_WITHDRAWALS=2

# ==================================================
# 6. TRANSFERS
# ==================================================
SKYDROP_TRANSFERS_ENABLED=false
SKYDROP_MIN_TRANSFER_NGN=100
SKYDROP_MAX_TRANSFER_NGN=100000

# ==================================================
# 7. EXCHANGE
# ==================================================
SKYDROP_EXCHANGE_ENABLED=false
SKYDROP_TRADING_ENABLED=false

# ==================================================
# 8. MINING AND REWARDS
# ==================================================
SKYDROP_MINING_ENABLED=true
SKYDROP_MINING_INTERVAL_SECONDS=300
SKYDROP_DAILY_REWARD_ENABLED=false

# ==================================================
# 9. CONVERSION
# ==================================================
SKYDROP_CONVERSION_ENABLED=false
SKD_UNITS_PER_TOKEN=100000000
SKD_REFERENCE_AMOUNT=0.00001
SKD_REFERENCE_USD=2000
USD_TO_NGN_REFERENCE_RATE=2000

# ==================================================
# 10. TRANSACTION SAFETY
# ==================================================
PAYMENT_WEBHOOK_VERIFICATION_REQUIRED=true
PAYMENT_RECONCILIATION_ENABLED=true
REJECT_DUPLICATE_TRANSACTIONS=true
REQUIRE_IDEMPOTENCY_KEY=true

# ==================================================
# 11. LOGGING
# ==================================================
LOG_LEVEL=info
LOG_SECRETS=false
LOG_PAYMENT_DETAILS=false

# ==================================================
# 12. CORS
# ==================================================
CORS_ORIGIN=http://localhost:3000

# ==================================================
# 13. ENVIRONMENT VALIDATION
# ==================================================
ENV_VALIDATION_ENABLED=true
RENDER_ENV_CHECK_ENABLED=true
