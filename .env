# ==================================================
# TACTICAL AI — APPLICATION CONFIGURATION
# ==================================================

NODE_ENV=development
PORT=3000
APP_NAME=Tactical AI

# ==================================================
# SKYDROP — WITHDRAWAL CONFIGURATION
# ==================================================

# Allow SkyDrop withdrawals.
SKYDROP_WITHDRAWALS_ENABLED=true

# Minimum withdrawal in NGN.
SKYDROP_MIN_WITHDRAWAL_NGN=100

# No application-level maximum withdrawal is configured.
# Do not add SKYDROP_MAX_WITHDRAWAL_NGN.

# ==================================================
# SKYDROP — WITHDRAWAL METHODS
# ==================================================

# Enable the Monnify withdrawal integration.
MONNIFY_ENABLED=true

# Enable the bank withdrawal method.
# A working, verified bank-transfer integration is still required.
SKYDROP_BANK_WITHDRAWALS_ENABLED=true

# ==================================================
# MONNIFY — BACKEND CONFIGURATION
# ==================================================

# Set the correct base URL for your Monnify environment.
MONNIFY_BASE_URL=

# Enter your actual credentials in your private .env file.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Configure only after verifying the correct disbursement endpoint
# for your approved Monnify product.
MONNIFY_DISBURSEMENT_PATH=

# API request timeout in milliseconds.
MONNIFY_REQUEST_TIMEOUT_MS=15000

# ==================================================
# END OF WITHDRAWAL CONFIGURATION
# ==================================================
