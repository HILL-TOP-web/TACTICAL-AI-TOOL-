# ==================================================
# TACTICAL AI — APPLICATION CONFIGURATION
# ==================================================

NODE_ENV=development
PORT=3000
APP_NAME=Tactical AI

# ==================================================
# SKYDROP — WITHDRAWAL CONFIGURATION
# ==================================================

# General withdrawal switch.
# Keep false until the withdrawal workflow is verified.
SKYDROP_WITHDRAWALS_ENABLED=false

# Minimum withdrawal in NGN.
SKYDROP_MIN_WITHDRAWAL_NGN=100

# IMPORTANT:
# Do not configure SKYDROP_MAX_WITHDRAWAL_NGN.
# The application-level maximum is unlimited.

# ==================================================
# SKYDROP — WITHDRAWAL METHODS
# ==================================================

# Monnify withdrawals.
MONNIFY_ENABLED=false

# Direct bank withdrawals.
# Enable only when a separate bank-transfer integration
# has been implemented and verified.
SKYDROP_BANK_WITHDRAWALS_ENABLED=false

# ==================================================
# MONNIFY — BACKEND CONFIGURATION
# ==================================================

# Use the correct base URL for your Monnify environment.
MONNIFY_BASE_URL=

# Enter your actual credentials in your private .env.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Keep empty until you verify the correct disbursement
# endpoint for your approved Monnify product.
MONNIFY_DISBURSEMENT_PATH=

# API request timeout in milliseconds.
MONNIFY_REQUEST_TIMEOUT_MS=15000

# ==================================================
# END OF WITHDRAWAL CONFIGURATION
# ==================================================
