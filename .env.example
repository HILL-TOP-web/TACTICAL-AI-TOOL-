# ==================================================
# TACTICAL AI — APPLICATION CONFIGURATION
# ==================================================

NODE_ENV=development
PORT=3000
APP_NAME=Tactical AI

# ==================================================
# ENVIRONMENT VALIDATION
# ==================================================

ENV_VALIDATION_ENABLED=true

# ==================================================
# SKYDROP — WITHDRAWAL CONFIGURATION
# ==================================================

# Allow SkyDrop withdrawal requests.
SKYDROP_WITHDRAWALS_ENABLED=true

# Minimum withdrawal amount in Nigerian naira.
SKYDROP_MIN_WITHDRAWAL_NGN=100

# Do not configure SKYDROP_MAX_WITHDRAWAL_NGN.
# The application-level maximum is unlimited.
# Provider limits, available balances, security controls,
# and applicable legal requirements still apply.

# ==================================================
# SKYDROP — WITHDRAWAL METHODS
# ==================================================

# Enable the Monnify integration.
MONNIFY_ENABLED=true

# Enable the bank withdrawal method.
# A separate, working bank-transfer integration is required.
SKYDROP_BANK_WITHDRAWALS_ENABLED=true

# ==================================================
# MONNIFY — BACKEND CONFIGURATION
# ==================================================

# Set the correct base URL for your Monnify environment.
# Use the sandbox URL for sandbox testing or the approved
# production URL for live transactions.
MONNIFY_BASE_URL=

# Set these values privately in your actual .env file.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Set only after verifying the disbursement endpoint
# supported by your approved Monnify product.
MONNIFY_DISBURSEMENT_PATH=

# API request timeout in milliseconds.
MONNIFY_REQUEST_TIMEOUT_MS=15000

# ==================================================
# END OF EXAMPLE CONFIGURATION
# ==================================================
