# ==================================================
# TACTICAL AI / SKYDROP
# ==================================================

NODE_ENV=development
PORT=3000

# ==================================================
# MONGODB DATABASE
# ==================================================

MONGODB_URI=mongodb://127.0.0.1:27017/skydrop

# ==================================================
# GENERAL AUTHENTICATION (LEGACY COMPATIBILITY)
# ==================================================

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ==================================================
# SKYDROP AUTHENTICATION
# ==================================================

SKYDROP_JWT_SECRET=
SKYDROP_JWT_EXPIRES_IN=15m
SKYDROP_PASSWORD_MIN_LENGTH=12
SKYDROP_BCRYPT_ROUNDS=12
SKYDROP_LOGIN_MAX_ATTEMPTS=5
SKYDROP_LOGIN_LOCK_MINUTES=15
SKYDROP_REFRESH_TOKEN_ENABLED=false

# ==================================================
# CORS
# ==================================================

CORS_ORIGIN=http://localhost:3000

# ==================================================
# SKYDROP WITHDRAWALS
# ==================================================

SKYDROP_WITHDRAWALS_ENABLED=true
SKYDROP_MONNIFY_WITHDRAWALS_ENABLED=true
SKYDROP_MIN_WITHDRAWAL_NGN=100

# ==================================================
# MONNIFY PRODUCTION CONFIGURATION
# ==================================================

MONNIFY_ENABLED=true
MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_API_KEY=replace_with_your_real_api_key
MONNIFY_SECRET_KEY=replace_with_your_real_secret_key
MONNIFY_CONTRACT_CODE=replace_with_your_real_contract_code

# ==================================================
# MONNIFY WEBHOOK
# ==================================================

MONNIFY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# ==================================================
# MONNIFY CONNECTIVITY CHECK
# ==================================================

MONNIFY_CONNECTIVITY_CHECK=false

# ==================================================
# LOGGING
# ==================================================

LOG_LEVEL=info
