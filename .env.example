# ==================================================
# TACTICAL AI — APPLICATION CONFIGURATION
# ==================================================

NODE_ENV=development
PORT=3000
APP_NAME=Tactical AI

# ==================================================
# DATABASE CONFIGURATION
# Preserve the variables required by your database.
# ==================================================

DATABASE_URL=
DATABASE_ID=

# ==================================================
# SKYDROP — WITHDRAWALS
# ==================================================

SKYDROP_WITHDRAWALS_ENABLED=false
SKYDROP_MIN_WITHDRAWAL_NGN=100

# No SKYDROP_MAX_WITHDRAWAL_NGN variable.
# The application-level maximum is unlimited.

# ==================================================
# SKYDROP — WITHDRAWAL METHODS
# ==================================================

MONNIFY_ENABLED=false
SKYDROP_BANK_WITHDRAWALS_ENABLED=false

# ==================================================
# MONNIFY — PROVIDER CONFIGURATION
# ==================================================

MONNIFY_BASE_URL=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Set only after verifying the correct endpoint.
MONNIFY_DISBURSEMENT_PATH=

MONNIFY_REQUEST_TIMEOUT_MS=15000

# ==================================================
# OPTIONAL INTEGRATIONS
# Add variables required by existing modules here.
# Never add actual credentials to this example.
# ==================================================
