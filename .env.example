# ==================================================
# TACTICAL AI — APPLICATION CONFIGURATION
# ==================================================

NODE_ENV=development
PORT=3000
APP_NAME=Tactical AI

# ==================================================
# ENVIRONMENT VALIDATION
# ==================================================

ENV_VALIDATION_ENABLED=true

# ==================================================
# SKYDROP — WITHDRAWAL CONFIGURATION
# ==================================================

SKYDROP_WITHDRAWALS_ENABLED=false
SKYDROP_MIN_WITHDRAWAL_NGN=100

# Do not configure SKYDROP_MAX_WITHDRAWAL_NGN.
# Provider limits, available balances, security controls,
# and applicable legal requirements still apply.

# ==================================================
# SKYDROP — WITHDRAWAL METHODS
# ==================================================

MONNIFY_ENABLED=false
SKYDROP_BANK_WITHDRAWALS_ENABLED=false

# ==================================================
# MONNIFY — BACKEND CONFIGURATION
# ==================================================

# Production URL; use only after production access is approved.
MONNIFY_BASE_URL=https://api.monnify.com

# Set real credentials privately in your local .env
# or Render Environment settings. Never commit real secrets.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Confirm the endpoint against your implemented Monnify client
# and approved API documentation before enabling withdrawals.
MONNIFY_DISBURSEMENT_PATH=

MONNIFY_REQUEST_TIMEOUT_MS=30000
