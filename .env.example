# ============================================================
# TACTICAL AI — SKYDROP ENVIRONMENT CONFIGURATION
# File: .env.example
# Purpose: Database, transactions, transfers, withdrawals,
#          Monnify, webhooks, reconciliation, and security.
# ============================================================


# ============================================================
# 1. APPLICATION
# ============================================================

NODE_ENV=development
PORT=3000

APP_NAME=Tactical AI
APP_MODULE=SkyDrop

# Public backend URL; replace with your deployed HTTPS URL.
APP_BASE_URL=http://localhost:3000

# Frontend URL used by CORS and redirect validation.
FRONTEND_URL=http://localhost:5173


# ============================================================
# 2. MONGODB DATABASE
# ============================================================

# MongoDB connection string.
# Use MongoDB Atlas or another secured MongoDB deployment.
MONGODB_URI=

# Optional database name if your connection code supports it.
MONGODB_DATABASE_NAME=skydrop

# Connection timeout in milliseconds.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Maximum connection pool size.
MONGODB_MAX_POOL_SIZE=20


# ============================================================
# 3. AUTHENTICATION AND SECURITY
# ============================================================

# Generate a strong, unique secret for your application.
JWT_SECRET=

# Token expiration.
JWT_EXPIRES_IN=1h

# Generate a separate, strong secret for refresh tokens if used.
JWT_REFRESH_SECRET=

# Refresh-token expiration.
JWT_REFRESH_EXPIRES_IN=7d

# Enable only if the application implements this feature.
SKYDROP_RATE_LIMIT_ENABLED=true

# Never expose secrets in application logs.
LOG_LEVEL=info


# ============================================================
# 4. SKYDROP TRANSACTIONS
# ============================================================

SKYDROP_TRANSACTIONS_ENABLED=true

# Unique transaction references must be generated by the backend.
SKYDROP_TRANSACTION_REFERENCE_PREFIX=SKD

# Enable idempotency protections only when implemented.
SKYDROP_TRANSACTION_IDEMPOTENCY_ENABLED=true

# Transaction history must use the authoritative transaction store.
SKYDROP_TRANSACTION_HISTORY_ENABLED=true


# ============================================================
# 5. SKYDROP TRANSFERS
# ============================================================

SKYDROP_TRANSFERS_ENABLED=true

# External transfers must not be marked successful merely because
# a request was submitted.
SKYDROP_TRANSFER_REQUIRE_PROVIDER_CONFIRMATION=true


# ============================================================
# 6. SKYDROP WITHDRAWALS
# ============================================================

SKYDROP_WITHDRAWALS_ENABLED=true
SKYDROP_MONNIFY_WITHDRAWALS_ENABLED=true

# Minimum withdrawal amount in Nigerian naira.
SKYDROP_MIN_WITHDRAWAL_NGN=100

# No maximum withdrawal limit is configured here.
# Do not add SKYDROP_MAX_WITHDRAWAL_NGN.


# ============================================================
# 7. MONNIFY — PRODUCTION
# ============================================================

MONNIFY_ENABLED=true

# Production API URL.
MONNIFY_BASE_URL=https://api.monnify.com

# Obtain these credentials from your Monnify account.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=


# ============================================================
# 8. SKYDROP — MONNIFY WEBHOOKS
# ============================================================

# Keep disabled until the webhook route and verification are tested.
SKYDROP_MONNIFY_WEBHOOKS_ENABLED=false

# Set this only if your implemented verification scheme requires it.
# Do not assume this is a Monnify-provided signing secret.
MONNIFY_WEBHOOK_SECRET=

# Optional: only if IP allowlisting is implemented.
# Configure according to Monnify's current official documentation.
MONNIFY_WEBHOOK_IP_ALLOWLIST=

# Webhook processing must verify authenticity, event type,
# transaction reference, and authoritative transaction status.


# ============================================================
# 9. SKYDROP — TRANSACTION RECONCILIATION
# ============================================================

# Keep disabled until the reconciler and its dependencies
# are correctly connected to the actual transaction repository.
SKYDROP_TRANSACTION_RECONCILIATION_ENABLED=false

SKYDROP_RECONCILIATION_BATCH_SIZE=50
SKYDROP_RECONCILIATION_TIMEOUT_MS=15000
SKYDROP_RECONCILIATION_STALE_MINUTES=5
SKYDROP_RECONCILIATION_MAX_ATTEMPTS=10
SKYDROP_RECONCILIATION_RETRY_DELAY_MS=30000
SKYDROP_RECONCILIATION_INTERVAL_MS=60000


# ============================================================
# 10. SKYDROP — WEBHOOK AND RECONCILIATION SAFETY
# ============================================================

# Prevent duplicate webhook processing only when the application
# implements durable event-ID or equivalent idempotency storage.
SKYDROP_WEBHOOK_IDEMPOTENCY_ENABLED=true

# Failed or inconsistent transactions should be reviewed.
SKYDROP_TRANSACTION_MANUAL_REVIEW_ENABLED=true


# ============================================================
# 11. SKYDROP — AUDIT LOGGING
# ============================================================

SKYDROP_AUDIT_LOG_ENABLED=true

# Do not log API secrets, authentication tokens, or full bank
# account details.
SKYDROP_AUDIT_LOG_SENSITIVE_DATA=false


# ============================================================
# 12. SKYDROP — OPTIONAL EXTERNAL SERVICES
# ============================================================

# Configure these only if the corresponding services are used.
# Leave empty otherwise.

REDIS_URL=

# Optional outbound email integration.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional email sender address.
SMTP_FROM=
