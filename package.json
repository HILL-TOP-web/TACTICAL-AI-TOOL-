{
  "name": "tactical-ai",
  "version": "1.0.0",
  "description": "Tactical AI — a controlled fictional training, simulation, decision-support, terrain, logistics, weather, routing, knowledge, and conversational AI platform.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "npm run check:env && node src/server.js",
    "dev": "npm run check:env && node --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js",
    "check:env": "node scripts/check-env.js",
    "check:monnify": "node scripts/check-monnify.js",
    "check:all": "npm run check && npm run check:env && npm test"
  },
  "keywords": [
    "tactical-ai",
    "simulation",
    "training",
    "decision-support",
    "terrain-analysis",
    "logistics",
    "weather",
    "routing",
    "knowledge-base",
    "conversation-ai",
    "skydrop"
  ],
  "author": "Daniel David Oluwayimika",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  }
}
